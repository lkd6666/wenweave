# 复制为 .env 后按需修改。所有变量均有合理默认值，最小化配置即可在本机跑起来。

# 运行环境。生产环境会拒绝默认 JWT 密钥、默认管理员账号和空 ENCRYPTION_KEY。
APP_ENV=development

# JWT 签发密钥，生产环境务必替换为至少 32 字符的随机长字符串
SECRET_KEY=change-this-to-a-random-secret-in-production

# 用于加密 AI Provider API Key / OSS AccessKeySecret 的对称密钥（Fernet Key）
# 留空则首次启动时自动生成并写入 backend/data/encryption.key（本机开发够用）
ENCRYPTION_KEY=

# MySQL 5.7+ / 8.0+ 连接串。请替换为真实账号、密码、主机与数据库名；必须使用 utf8mb4。
# 先以有建库权限的账号执行：CREATE DATABASE yibanpaiban CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+pymysql://yibanpaiban:change-me@127.0.0.1:3306/yibanpaiban?charset=utf8mb4
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0

# JWT access token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 登录活动中的 access token 会通过 HttpOnly 刷新 Cookie 自动续期；该 Cookie 有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=30

# 首次启动自动创建的管理员账号（仅在用户表为空时生效）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# 允许跨域访问的前端地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 仅当请求的直连地址属于这些 CIDR 时，才信任 CF-Connecting-IP、Forwarded
# 与 X-Forwarded-For。后端会从右向左跳过可信代理，取第一个非可信地址作为客户端 IP。
# CDN -> 雷池 -> Nginx -> Uvicorn 时，填写 Uvicorn 直连的 Nginx 地址（如 127.0.0.1/32）、
# 雷池回源地址/网段和 CDN 官方出口网段；不要填写 0.0.0.0/0 或用户网段。
# 多个网段用逗号分隔，例如 127.0.0.1/32,172.18.0.0/16,198.51.100.0/24。
# Uvicorn 必须以 --no-proxy-headers 启动，由应用按本配置统一解析来源地址。
TRUSTED_PROXY_CIDRS=

# 公开分享页中对象存储图片 URL 的最长有效期（秒）。
DOCUMENT_SHARE_IMAGE_URL_EXPIRE_SECONDS=3600

# 独立 SearXNG 图片搜索服务。HTTP 仅允许本机回环地址；远程实例必须使用 HTTPS。
SEARXNG_HOST_PORT=8088
SEARXNG_BASE_URL=http://127.0.0.1:8088
SEARXNG_TIMEOUT_SECONDS=4
SEARXNG_SEARCH_CACHE_SECONDS=300
# 图片代理密钥默认从 deploy/searxng/.env 读取；外部部署也可在这里覆盖。

# AI 新建模板（含整套主题）的最长生成时间（秒）。复杂模板可能需要数分钟，修改后需重启后端。
TEMPLATE_GENERATION_TIMEOUT_SECONDS=600

# Agent 默认最多运行 1 小时；单次模型调用最多等待 5 分钟产生首个有效输出，
# 已开始输出后允许最多 5 分钟的进度间隔。工具名已生成后，大型 JSON 参数
# （例如全文替换）最多允许 20 分钟的参数输出间隔。请求超时必须不小于此值。
# 部署环境可按实际模型延迟继续调高；修改后需重启后端生效。
CHAT_AGENT_MAX_RUNTIME_SECONDS=3600
# 新运行使用通用源码工具；v1 可回退到旧块工具。已暂停任务沿用保存的协议。
CHAT_AGENT_TOOL_PROTOCOL=v2
CHAT_AGENT_MODEL_REQUEST_TIMEOUT_SECONDS=1260
CHAT_AGENT_MODEL_FIRST_PROGRESS_TIMEOUT_SECONDS=300
CHAT_AGENT_MODEL_PROGRESS_IDLE_TIMEOUT_SECONDS=300
CHAT_AGENT_MODEL_TOOL_ARGUMENT_IDLE_TIMEOUT_SECONDS=1200
# Anthropic 原生缓存支持 5m/1h；长排版对话默认使用 1h。旧网关拒绝 ttl 时会自动回退。
CHAT_AGENT_ANTHROPIC_CACHE_TTL=1h
# 同时执行的 Agent 总量，以及同一用户同时执行的 Agent 数量。修改后需重启后端。
CHAT_AGENT_MAX_CONCURRENT_RUNS=10
CHAT_AGENT_MAX_CONCURRENT_RUNS_PER_USER=3

# 微信官方 verify-article-structure-spec 合规引擎。它只在模型主动调用或
# 用户手动检测时运行，并由一个复用的 Playwright Chromium 工作线程串行执行。
# 留空时使用 Playwright 管理的 Chromium headless shell；如使用系统浏览器，填写绝对路径。
# 首次启动最多 40 秒，规则执行最多 20 秒；检测结束 10 秒后释放浏览器，120 秒后释放驱动。
WECHAT_COMPLIANCE_CHECK_TIMEOUT_SECONDS=20
WECHAT_COMPLIANCE_BROWSER_STARTUP_TIMEOUT_SECONDS=40
WECHAT_COMPLIANCE_BROWSER_EXECUTABLE_PATH=
WECHAT_COMPLIANCE_BROWSER_IDLE_SECONDS=10
WECHAT_COMPLIANCE_DRIVER_IDLE_SECONDS=120

# ask_user 提问在用户完全无操作 2 分钟后自动回复“用户未回复”，并继续 Agent。
# 可按业务需要调整为更长时间。
CHAT_USER_QUESTION_INACTIVITY_SECONDS=120

# Agent 事件以 250ms / 4KiB 为界批量写入 MySQL；关键工具、错误和终态仍会立即刷盘。
# 保持以下默认值即可。仅在监控明确显示数据库吞吐不足时再调整。
CHAT_AGENT_EVENT_FLUSH_INTERVAL_SECONDS=0.25
CHAT_AGENT_EVENT_FLUSH_MAX_BYTES=4096
CHAT_AGENT_EVENT_PENDING_MAX_BYTES=524288
CHAT_AGENT_RUN_LOCAL_TTL_SECONDS=300
CHAT_AGENT_RUN_LEASE_RENEW_INTERVAL_SECONDS=10
CHAT_AGENT_LEASE_RECOVERY_INTERVAL_SECONDS=5
CHAT_AGENT_CONTEXT_STATS_STREAM_INTERVAL_SECONDS=2

# 参考排版仅缓存最近使用的少量解析结果；淘汰后会从数据库持久化记录恢复。
LAYOUT_REFERENCE_CACHE_MAX_ENTRIES=16
LAYOUT_REFERENCE_CACHE_MAX_BYTES=33554432
